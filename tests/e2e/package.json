{
  "name": "mmpi-e2e-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "E2E tests for MMPI Test System using Playwright",
  "scripts": {
    "test": "node node_modules/@playwright/test/cli.js test --project=chromium --reporter=html",
    "test:headed": "node node_modules/@playwright/test/cli.js test --headed",
    "test:debug": "node node_modules/@playwright/test/cli.js test --debug",
    "show-report": "playwright show-report --host 0.0.0.0 --port 9323",
    "report": "node node_modules/@playwright/test/cli.js show-report reports",
    "server": "node server.js",
    "test:docker": "docker compose run --rm e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}